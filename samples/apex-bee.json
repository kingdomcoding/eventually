{
  "schemaVersion": 1,
  "meta": {
    "id": "apex-bee-streams",
    "name": "Apex Bee — EventStore streams",
    "version": 3,
    "modelVersion": 1
  },
  "swimlanes": [
    {
      "id": "stream-device",
      "name": "Device",
      "band": "events",
      "order": 0,
      "streamPattern": "device-{deviceToken}",
      "streamShape": {
        "entryOneOf": ["evt-device-imported", "evt-device-registered"],
        "layoutColumns": [
          ["evt-device-imported", "evt-device-registered"],
          ["evt-device-revoked"]
        ]
      }
    },
    {
      "id": "stream-subscription",
      "name": "Subscription",
      "band": "events",
      "order": 1,
      "streamPattern": "subscription-{userId}",
      "streamShape": {
        "entryOneOf": ["evt-entitlement-imported", "evt-trial-started"],
        "layoutColumns": [
          ["evt-entitlement-imported", "evt-trial-started"],
          ["evt-subscription-activated"],
          ["evt-subscription-updated"],
          ["evt-subscription-cancelled"]
        ]
      }
    },
    {
      "id": "stream-payment",
      "name": "Payment",
      "band": "events",
      "order": 2,
      "streamPattern": "payment-{reference}",
      "streamShape": {
        "entryOneOf": [
          "evt-payment-initiated",
          "evt-payment-imported",
          "evt-manual-payment"
        ],
        "layoutColumns": [
          ["evt-payment-initiated", "evt-payment-imported", "evt-manual-payment"],
          ["evt-payment-confirmed"]
        ]
      }
    },
    {
      "id": "stream-attempt",
      "name": "Exam attempt",
      "band": "events",
      "order": 3,
      "streamPattern": "attempt-{attemptId}"
    },
    {
      "id": "stream-interview",
      "name": "Interview session",
      "band": "events",
      "order": 4,
      "streamPattern": "interview-{sessionId}",
      "streamShape": {
        "exitOneOf": ["evt-interview-finished", "evt-interview-abandoned"],
        "layoutColumns": [
          ["evt-interview-started"],
          ["evt-interview-scored"],
          ["evt-interview-advanced"],
          ["evt-interview-finished", "evt-interview-abandoned"]
        ]
      }
    },
    {
      "id": "stream-group",
      "name": "Study group",
      "band": "events",
      "order": 5,
      "streamPattern": "group-{cohortId}"
    },
    {
      "id": "stream-joint",
      "name": "Joint exam",
      "band": "events",
      "order": 6,
      "streamPattern": "session-{sessionId}"
    },
    {
      "id": "stream-flag",
      "name": "Question flag",
      "band": "events",
      "order": 7,
      "streamPattern": "flag-{flagId}",
      "streamShape": {
        "entryOneOf": ["evt-flag-imported", "evt-flag-raised"],
        "layoutColumns": [
          ["evt-flag-imported", "evt-flag-raised"],
          ["evt-flag-resolved"]
        ]
      }
    }
  ],
